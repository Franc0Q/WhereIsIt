<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/photo_sheet_title"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTakePhoto_sheet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/ic_camera"
        android:drawableTint="@color/text_secondary"
        android:focusable="true"
        android:gravity="center_vertical"
        android:text="@string/photo_take"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvGallery_sheet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/ic_image"
        android:drawableTint="@color/text_secondary"
        android:focusable="true"
        android:gravity="center_vertical"
        android:text="@string/photo_gallery"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvVideo_sheet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/ic_videocam"
        android:drawableTint="@color/text_secondary"
        android:focusable="true"
        android:gravity="center_vertical"
        android:text="@string/photo_video"
        android:textColor="@color/text_primary" />
</LinearLayout>